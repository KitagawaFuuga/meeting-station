# /api/meeting と /api/meeting/path のレート制限: 1 IP が瞬間的に出せるリクエスト数（既定 20）。
# 定常レートは 0.5 req/s 固定。2つの API の合計で数える。詳細は app/api/meeting/config.ts
RATE_LIMIT_CAPACITY=

# 同じ3駅の組の候補を使い回す件数（既定 200）
MEETING_CACHE_ENTRIES=

# 経路の API（/api/meeting/path）のレート制限。候補一覧とは別に数える（既定 60、定常 2 req/s）
PATH_RATE_LIMIT_CAPACITY=
